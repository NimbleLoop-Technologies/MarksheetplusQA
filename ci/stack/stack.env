# Non-secret configuration of the throwaway CI stack (ci/stack/docker-compose.yml).
# These datastores are reachable only inside the compose network of one CI run and are destroyed
# with it. The values are deliberately NOT the MarksheetPlus dev defaults (admin123, guest/guest,
# minioadmin) so nothing here can match a credential on a shared environment.
QA_CI_PG_USER=qaci
QA_CI_PG_PASSWORD=qaci-pg-throwaway
QA_CI_RABBIT_USER=qaci
QA_CI_RABBIT_PASSWORD=qaci-mq-throwaway
QA_CI_MINIO_USER=qaci-minio
QA_CI_MINIO_PASSWORD=qaci-minio-throwaway

# Public ports (https://localhost:<port>) published on 127.0.0.1 by the edge container.
# The defaults match the MarksheetPlus dev launch profiles, which the QA fixtures default to.
QA_CI_API_PORT=7244
QA_CI_AUTH_PORT=7104
QA_CI_WEB_PORT=7236
QA_CI_FAMILY_PORT=7100
