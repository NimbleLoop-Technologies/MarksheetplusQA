# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Web app under test. Sign-in redirects (OIDC) to the auth app below and back.
QA_BASE_URL=https://qa-integration.marksheetplus.com
QA_AUTH_URL=https://qa-integration-auth.marksheetplus.com

# Seeded QA test account: an existing campus owner with at least one student.
# WhatsApp number (03xxxxxxxxx / +923xxxxxxxxx) or email both work as the username.
QA_EMAIL=
QA_PASSWORD=

# Set to true to let tests/anonymous/register.spec.ts create a real account on the shared
# environment. Off by default so routine regression runs do not pile up throwaway tenants.
QA_ALLOW_SIGNUP=false
