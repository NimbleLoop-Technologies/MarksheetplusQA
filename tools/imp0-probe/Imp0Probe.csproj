<Project Sdk="Microsoft.NET.Sdk">
  <!-- IMP-0 (CU-z94x8eebcc) black-box probe: runs the MarksheetPlus.Core.Import normalisers on QA-owned inputs and prints JSON.
       Build: dotnet build -p:MpDir=<MarksheetPlus checkout>. Used by tests/import-normalisers. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <MpDir Condition="'$(MpDir)' == ''">$(QA_CI_MP_DIR)</MpDir>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MpDir)/src/MarksheetPlusCode/MarksheetPlus.Core/MarksheetPlus.Core.csproj" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
  </ItemGroup>
</Project>
